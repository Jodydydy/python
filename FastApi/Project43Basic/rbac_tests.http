@baseUrl = http://127.0.0.1:8000

### 1. Login admin
# @name loginAdmin
POST {{baseUrl}}/login
Content-Type: application/json

{"username":"admin","password":"adminpass"}

### 2. Login user
# @name loginUser
POST {{baseUrl}}/login
Content-Type: application/json

{"username":"user","password":"userpass"}

### 3. Login guest
# @name loginGuest
POST {{baseUrl}}/login
Content-Type: application/json

{"username":"guest","password":"guestpass"}


###3.1 Login guest2
# @name loginGuest2
POST {{baseUrl}}/login
Content-Type: application/json

{"username":"guest2","password":"guestpass2"}

### 4. Admin creates post — expect 200
POST {{baseUrl}}/create
Authorization: Bearer {{loginAdmin.response.body.$.access_token}}
Content-Type: application/json

{"id":101,"message":"Created by admin"}

### 5. User cannot create — expect 403
POST {{baseUrl}}/create
Authorization: Bearer {{loginUser.response.body.$.access_token}}
Content-Type: application/json

{"id":102,"message":"User should be denied"}

### 6. Guest cannot create — expect 403
POST {{baseUrl}}/create
Authorization: Bearer {{loginGuest.response.body.$.access_token}}
Content-Type: application/json

{"id":103,"message":"Guest should be denied"}

### 7. Admin reads — expect 200
GET {{baseUrl}}/read
Authorization: Bearer {{loginAdmin.response.body.$.access_token}}
Content-Type: application/json

{"id":101}

### 8. User reads — expect 200
GET {{baseUrl}}/read
Authorization: Bearer {{loginUser.response.body.$.access_token}}
Content-Type: application/json

{"id":101}

### 9. Guest reads — expect 200
GET {{baseUrl}}/read
Authorization: Bearer {{loginGuest.response.body.$.access_token}}
Content-Type: application/json

{"id":101}

### 9.1 Guest reads — expect 200
GET {{baseUrl}}/read
Authorization: Bearer {{loginGuest2.response.body.$.access_token}}
Content-Type: application/json

{"id":101}

### 10. Guest cannot update — expect 403
PUT {{baseUrl}}/update
Authorization: Bearer {{loginGuest.response.body.$.access_token}}
Content-Type: application/json

{"id":101,"message":"Guest should be denied"}

### 11. User updates — expect 200
PUT {{baseUrl}}/update
Authorization: Bearer {{loginUser.response.body.$.access_token}}
Content-Type: application/json

{"id":101,"message":"Updated by user"}

### 12. Admin updates — expect 200
PUT {{baseUrl}}/update
Authorization: Bearer {{loginAdmin.response.body.$.access_token}}
Content-Type: application/json

{"id":101,"message":"Updated by admin"}

### 13. User cannot delete — expect 403
DELETE {{baseUrl}}/delete
Authorization: Bearer {{loginUser.response.body.$.access_token}}
Content-Type: application/json

{"id":101}

### 14. Guest cannot delete — expect 403
DELETE {{baseUrl}}/delete
Authorization: Bearer {{loginGuest.response.body.$.access_token}}
Content-Type: application/json

{"id":101}

### 15. Admin protected resource — expect 200
GET {{baseUrl}}/protected_resource/bob
Authorization: Bearer {{loginAdmin.response.body.$.access_token}}

### 16. User protected resource — expect 200
GET {{baseUrl}}/protected_resource
Authorization: Bearer {{loginUser.response.body.$.access_token}}

### 17. Guest protected resource — expect 403
GET {{baseUrl}}/protected_resource
Authorization: Bearer {{loginGuest.response.body.$.access_token}}

### 18. No token protected resource — expect 401 or 403 depending on dependency order
GET {{baseUrl}}/protected_resource

### 19. Invalid token — expect 401 or 403 depending on dependency order
GET {{baseUrl}}/protected_resource
Authorization: Bearer invalid.jwt.token

### 20. Admin deletes — expect 200 (run last)
DELETE {{baseUrl}}/delete
Authorization: Bearer {{loginAdmin.response.body.$.access_token}}
Content-Type: application/json

{"id":101}
